.cxx/

# generated inline modules
app/src/main/java/inline/

# Per-flavor Firebase config — copied in by withFirebaseAndroid.js from the
# gitignored firebase/google-services.*.json at prebuild time; never committed
# (confirmed via `git ls-tree HEAD` — not present even for jodii/tamil/malayalam
# historically).
app/src/*/google-services.json

# Bundle artifacts
*.jsbundle

# Per-flavor source sets for the 52 community/language flavors added beyond
# jodii/tamil/malayalam — entirely regenerated by `expo prebuild --platform
# android` from constants/flavorConfig.js (icons) and firebase/google-services.*.json
# (which itself is gitignored, see repo-root .gitignore), so committing them
# would just be churn. jodii/tamil/malayalam stay tracked since they predate
# this and may still contain hand-placed assets.
