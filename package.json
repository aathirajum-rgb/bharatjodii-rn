{
  "name": "jodii",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "axios": "^1.18.0",
    "crypto-js": "^4.2.0",
    "expo": "~56.0.9",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.17",
    "expo-media-library": "~56.0.7",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.17",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "lottie-react-native": "~7.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "node scripts/setup-env.js dev && EXPO_PUBLIC_APP_ENV=dev expo start",
    "start:uat": "node scripts/setup-env.js uat && EXPO_PUBLIC_APP_ENV=uat expo start",
    "start:preprod": "node scripts/setup-env.js preprod && EXPO_PUBLIC_APP_ENV=preprod expo start",
    "start:prod": "node scripts/setup-env.js prod && EXPO_PUBLIC_APP_ENV=prod expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "convert:pwa": "node scripts/convert-pwa.js",
    "build:web": "npx expo export --platform web",
    "build:web:tamil": "cross-env EXPO_PUBLIC_APP_FLAVOR=tamil EXPO_PUBLIC_APP_TYPE=116 npx expo export --platform web --output-dir dist-tamil",
    "build:web:malayalam": "cross-env EXPO_PUBLIC_APP_FLAVOR=malayalam EXPO_PUBLIC_APP_TYPE=118 npx expo export --platform web --output-dir dist-malayalam",
    "build:web:jodii": "cross-env EXPO_PUBLIC_APP_FLAVOR=jodii EXPO_PUBLIC_APP_TYPE=115 npx expo export --platform web --output-dir dist-jodii",
    "serve:dev:jodi": "cross-env FLAVOR=jodii node scripts/web-server.js",
    "serve:dev:tamil": "cross-env FLAVOR=tamil node scripts/web-server.js",
    "serve:dev:malayalam": "cross-env FLAVOR=malayalam node scripts/web-server.js",
    "serve:dev:hindi": "cross-env FLAVOR=hindi node scripts/web-server.js",
    "serve:dev:hindhi": "cross-env FLAVOR=hindhi node scripts/web-server.js",
    "serve:dev:bengali": "cross-env FLAVOR=bengali node scripts/web-server.js",
    "serve:dev:gujarati": "cross-env FLAVOR=gujarati node scripts/web-server.js",
    "serve:dev:kannada": "cross-env FLAVOR=kannada node scripts/web-server.js",
    "serve:dev:marathi": "cross-env FLAVOR=marathi node scripts/web-server.js",
    "serve:dev:oriya": "cross-env FLAVOR=oriya node scripts/web-server.js",
    "serve:dev:eng": "cross-env FLAVOR=eng node scripts/web-server.js",
    "serve:prod:tamil": "cross-env NODE_ENV=production FLAVOR=tamil node scripts/web-server.js",
    "serve:prod:malayalam": "cross-env NODE_ENV=production FLAVOR=malayalam node scripts/web-server.js",
    "serve:prod:hindi": "cross-env NODE_ENV=production FLAVOR=hindi node scripts/web-server.js",
    "prebuild": "expo prebuild --platform android",
    "assemble:jodii": "EXPO_PUBLIC_APP_FLAVOR=jodii EXPO_PUBLIC_APP_TYPE=115 ./android/gradlew -p android assembleJodiiRelease",
    "assemble:tamil": "EXPO_PUBLIC_APP_FLAVOR=tamil EXPO_PUBLIC_APP_TYPE=116 ./android/gradlew -p android assembleTamilRelease",
    "assemble:malayalam": "EXPO_PUBLIC_APP_FLAVOR=malayalam EXPO_PUBLIC_APP_TYPE=118 ./android/gradlew -p android assembleMalayalamRelease",
    "release:tamil:apk": "set JODII_KEYSTORE_FILE=jodii-release.keystore && set JODII_KEY_ALIAS=jodii-release && set JODII_STORE_PASSWORD=YOUR_STORE_PASS && set JODII_KEY_PASSWORD=YOUR_KEY_PASS && npm run assemble:tamil",
    "release:tamil:aab": "set JODII_KEYSTORE_FILE=jodii-release.keystore && set JODII_KEY_ALIAS=jodii-release && set JODII_STORE_PASSWORD=YOUR_STORE_PASS && set JODII_KEY_PASSWORD=YOUR_KEY_PASS && npm run bundle:tamil",
    "assemble:all": "npm run assemble:jodii && npm run assemble:tamil && npm run assemble:malayalam",
    "bundle:jodii": "EXPO_PUBLIC_APP_FLAVOR=jodii EXPO_PUBLIC_APP_TYPE=115 ./android/gradlew -p android bundleJodiiRelease",
    "bundle:tamil": "EXPO_PUBLIC_APP_FLAVOR=tamil EXPO_PUBLIC_APP_TYPE=116 ./android/gradlew -p android bundleTamilRelease",
    "bundle:malayalam": "EXPO_PUBLIC_APP_FLAVOR=malayalam EXPO_PUBLIC_APP_TYPE=118 ./android/gradlew -p android bundleMalayalamRelease",
    "bundle:all": "npm run bundle:jodii && npm run bundle:tamil && npm run bundle:malayalam",
    "eas:jodii:apk": "eas build --platform android --profile jodii-preview",
    "eas:jodii:aab": "eas build --platform android --profile jodii-production",
    "eas:tamil:apk": "eas build --platform android --profile tamil-preview",
    "eas:tamil:aab": "eas build --platform android --profile tamil-production",
    "eas:malayalam:apk": "eas build --platform android --profile malayalam-preview",
    "eas:malayalam:aab": "eas build --platform android --profile malayalam-production",
    "build:ios": "eas build --platform ios --profile production",
    "ota:production": "CHANNEL_SUFFIX=production node scripts/deploy-ota.js",
    "ota:preview": "CHANNEL_SUFFIX=preview node scripts/deploy-ota.js",
    "ota:server": "node ../jodii-ota-server/server.js"
  },
  "private": true
}
