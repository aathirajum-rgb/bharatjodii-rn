# ─────────────────────────────────────────────────────────────────────
#  ENV TEMPLATE — for reference only (committed to git).
#  Per-environment switching is handled by npm run start:dev / start:uat
#  etc. via inline EXPO_PUBLIC_APP_ENV — no per-env files needed here.
#
#  If you need a local .env at root, copy the relevant lines below.
# ─────────────────────────────────────────────────────────────────────

# Controls which API base URLs are loaded from constants/env/
# Values: dev | uat | preprod | prod
EXPO_PUBLIC_APP_ENV=dev

# ── Firebase ───────────────────────────────────────────────────────
# Firebase web API key — injected into getFirebaseConfig() at runtime.
# Per-language appId / measurementId are in constants/firebase.config.ts (committed).
# Native Firebase files (google-services.json / GoogleService-Info.plist) are
# copied per-env by scripts/setup-env.js from the firebase/ folder.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# ── Sentry (optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ── AppsFlyer (optional) ───────────────────────────────────────────
# Needs the EXPO_PUBLIC_ prefix (like the Firebase key above) to be readable
# at runtime via process.env — see service/analyticsService.ts's initAnalytics().
# Leave blank to skip AppsFlyer init entirely (Firebase Analytics still works).
EXPO_PUBLIC_APPSFLYER_DEV_KEY=

# ── OTA (required) ──────────────────────────────────────────────────
# app.config.js reads these from a root-level .env.ota file (gitignored,
# not this one) — it throws if OTA_MANIFEST_URL is missing. The rest are
# only needed to actually run scripts/deploy-ota.js. Copy this block into
# .env.ota at the repo root and fill in real values (ask a teammate for
# SFTP credentials).
OTA_MANIFEST_URL=
OTA_SERVER_URL=
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_OTA_PATH=
CHANNEL_SUFFIX=production
