node_modules/
.expo/
dist/
web-build/

# Claude Code internal data — agent worktrees, memory, task logs
.claude/

# macOS Finder metadata — never commit
.DS_Store
**/.DS_Store

# Generated .env (never commit this — it's copied by setup-env.js)
.env

# OTA deployment config — contains real SFTP credentials, never commit
.env.ota

# Firebase — real keys go here, never commit
firebase/google-services.*.json
firebase/GoogleService-Info.*.plist

# Env files with real keys — ignore all except the template
envs/.env.*
!envs/.env.template

# Android/iOS generated firebase files
android/app/google-services.json
ios/GoogleService-Info.plist

# Release signing keystore — real production key, never commit
android/app/*.keystore
android/app/*.jks

# Playwright MCP debug logs/snapshots — not project source
.playwright-mcp/

# Ad-hoc screenshots dropped at repo root during testing
/edit-profile-desktop-1.png
